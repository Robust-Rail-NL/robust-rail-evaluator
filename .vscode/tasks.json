{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake build debug",
            "type": "shell",
            "command": "./build.sh -DCMAKE_BUILD_TYPE=Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "cmake build release",
            "type": "shell",
            "command": "./build.sh -DCMAKE_BUILD_TYPE=Release",
            "group": "build",
            "problemMatcher": "$gcc"
        }
    ]
}
